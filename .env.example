HEIMDALL_CONTROL_DB_PASSWORD=
HEIMDALL_CONTROL_DB_PORT=55432
HEIMDALL_API_PORT=8000
HEIMDALL_FRONTEND_PORT=5173
HEIMDALL_DATABASE_URL=postgresql://heimdall:${HEIMDALL_CONTROL_DB_PASSWORD}@127.0.0.1:55432/heimdall_control
HEIMDALL_MANAGED_DB_PROVISIONER_PASSWORD=
HEIMDALL_MANAGED_DB_HOST=host.docker.internal
HEIMDALL_MANAGED_DB_PORT=55433
HEIMDALL_PROJECT_DB_ENABLED=true
HEIMDALL_PROJECT_DB_ADMIN_URL=postgresql://heimdall_provisioner:${HEIMDALL_MANAGED_DB_PROVISIONER_PASSWORD}@127.0.0.1:55433/postgres
HEIMDALL_PROJECT_DB_RUNTIME_HOST=host.docker.internal
HEIMDALL_PROJECT_DB_RUNTIME_PORT=55433
HEIMDALL_RUNTIME_ROOT=/absolute/path/to/heimdall-python/.heimdall-local/runtime
HEIMDALL_BROKER_SOCKET_ROOT=/absolute/path/to/heimdall-python/.heimdall-local/runtime
HEIMDALL_AUTH_SECRET_ROOT=/absolute/private/path/heimdall-auth
HEIMDALL_AUTH_COOKIE_SECURE=true
HEIMDALL_RUNTIME_PROBE_HOST=127.0.0.1
HEIMDALL_GIT_WORKSPACE_ROOT=/absolute/path/to/heimdall-python/.heimdall-local/git
HEIMDALL_DOCKER_EXECUTABLE=docker
HEIMDALL_NGINX_IMAGE=nginx:1.29-alpine
HEIMDALL_RUNTIME_COMMAND_TIMEOUT_SECONDS=900
HEIMDALL_RUNTIME_HEALTH_TIMEOUT_SECONDS=60
HEIMDALL_SERVICE_LOG_COMMAND_TIMEOUT_SECONDS=5
HEIMDALL_SERVICE_LOG_BROKER_TIMEOUT_SECONDS=6
HEIMDALL_WORKER_LEASE_SECONDS=120
HEIMDALL_WORKER_POLL_SECONDS=1
HEIMDALL_WORKER_MAX_ATTEMPTS=3
HEIMDALL_RUNTIME_RETENTION_HOURS=72
HEIMDALL_DIAGNOSTIC_RETENTION_DAYS=30
HEIMDALL_MANAGEMENT_HOSTNAME=heimdall.localhost
HEIMDALL_DEPLOYMENT_BASE_DOMAIN=deployments.localhost
HEIMDALL_RESERVED_PUBLIC_SUBDOMAINS=
HEIMDALL_EDGE_CONFIG_ROOT=/absolute/path/to/heimdall-python/.heimdall-local/edge
HEIMDALL_EDGE_NETWORK_NAME=heimdall-edge
HEIMDALL_EDGE_CONTAINER_NAME=heimdall-edge-gateway
HEIMDALL_EDGE_NGINX_IMAGE=nginx:1.29-alpine
HEIMDALL_EDGE_HTTP_BIND_ADDRESS=127.0.0.1
HEIMDALL_EDGE_HTTP_PORT=8088
HEIMDALL_EDGE_PROBE_HOST=127.0.0.1
HEIMDALL_ROUTING_WORKER_LEASE_SECONDS=60
HEIMDALL_ROUTING_WORKER_POLL_SECONDS=1
HEIMDALL_ROUTING_WORKER_MAX_ATTEMPTS=3
HEIMDALL_ROUTING_WORKER_RETRY_SECONDS=5
HEIMDALL_ROUTING_WORKER_RETRY_MAX_SECONDS=60
