upstream heimdall_control_frontend {
    zone heimdall_control_frontend 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server heimdall-control-frontend:80 resolve;
}

server {
    listen 80 default_server;
    server_name _;
    return 404;
}

server {
    listen 80;
    server_name ${HEIMDALL_MANAGEMENT_HOSTNAME};
    add_header X-Heimdall-Management "true" always;

    location / {
        proxy_pass http://heimdall_control_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
